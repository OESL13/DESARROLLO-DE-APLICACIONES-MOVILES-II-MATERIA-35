                <ImageButton android:id="@+id/share8" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="6dp" android:background="@android:color/transparent" android:src="@drawable/share" android:scaleType="centerInside" android:padding="0dp" android:contentDescription="@string/compartir_cancion" />
                <ImageButton android:id="@+id/blue8" android:layout_width="34dp" android:layout_height="34dp" android:background="@android:color/transparent" android:src="@drawable/blue" android:scaleType="centerInside" android:padding="0dp" android:contentDescription="@string/enviar_bluetooth" />
            </LinearLayout>

            <!-- Canción 9 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <ImageButton android:id="@+id/play9" android:layout_width="34dp" android:layout_height="34dp" android:background="@android:color/transparent" android:src="@drawable/play" android:scaleType="centerInside" android:padding="0dp" android:contentDescription="@string/reproducir_cancion" />
