                <TextView android:id="@+id/cancion2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="@string/cancion2" android:textColor="#000000" android:textSize="13sp" />
