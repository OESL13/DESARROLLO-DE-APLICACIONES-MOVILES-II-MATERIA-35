            </LinearLayout>

            <!-- Canción 7 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <ImageButton android:id="@+id/play7" android:layout_width="34dp" android:layout_height="34dp" android:background="@android:color/transparent" android:src="@drawable/play" android:scaleType="centerInside" android:padding="0dp" android:contentDescription="@string/reproducir_cancion" />
