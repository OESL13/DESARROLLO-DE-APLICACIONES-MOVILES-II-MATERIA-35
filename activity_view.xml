                <ImageButton android:id="@+id/blue2" android:layout_width="34dp" android:layout_height="34dp" android:background="@android:color/transparent" android:src="@drawable/blue" android:scaleType="centerInside" android:padding="0dp" android:contentDescription="@string/enviar_bluetooth" />
            </LinearLayout>

            <!-- Canción 3 -->
